# --- Секреты (НИКОГДА не пушить) ---
ключ_яндекса.txt
.env
*.key

# --- Служебные каталоги ---
.py-libs/
браузеры/
голоса/
node_modules/
chemistry-demo/node_modules/
chemistry-demo/dist/
chemistry-demo/.npm-cache/
шрифты/
скилы/
__pycache__/
*.pyc
*.pyo
.DS_Store
:memory:.ses
*.log
визуальный_консилиум/
deepseek-harness/

# --- В репозитории — ТОЛЬКО приложение MVP и корневые файлы приложения ---
/*
!/MVP/
!/MVP/**
!/index.html
!/sw.js
!/manifest.webmanifest
!/README.md
# продуктовая правда: нужна следующей сессии, иначе потеряется как qa_frame.py
!/PRODUCT.md
# дизайн-система деки: без неё следующая сессия начнёт подбирать значения заново
!/MASTER.md
# рукописная гарнитура стартовой страницы: без неё реплика Архимеда
# падает на запасной шрифт — проверено, на проде был 404
!/fonts/
!/fonts/**
!/.gitignore
!шлюз_сервер.py

# --- инструменты проекта (без секретов) ---
# Проверки версионируем: без них новую сессию нечем принять работу.
# До этого в репозитории лежал только qa_layout.py, а гейт отклика, аудит
# интерфейса и общий набор русского направления оставались вне git и терялись.
!/qa_layout.py
!/qa_ui.py
!/qa_feedback.py
!/qa_ru.py
!/qa_ru_items.js
# qa_frame.py и qa_ru_trainers.py были написаны позже и в белый список не попали:
# инструкция называет их основными, а в git их не было — восстановлено.
!/qa_frame.py
!/qa_ru_trainers.py
!/deploy/
!/deploy/**
deploy/deploy.local.env
# «!/deploy/**» перебивает общий запрет __pycache__ выше — закрываем отдельно
deploy/__pycache__/
