@import url(https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Roboto:wght@400;500&display=swap);
.stages{position:relative}.stages__caption{color:#1d1d1d;font-family:Montserrat;font-size:44px;font-style:normal;font-weight:600;letter-spacing:-.03em;line-height:56px;margin-bottom:56px}.stages__viewport{-ms-overflow-style:none;overflow-x:scroll;overflow-y:hidden;scroll-behavior:smooth;scrollbar-width:none}.stages__viewport::-webkit-scrollbar{display:none}.stages__stages-cards{display:flex;gap:32px;width:-webkit-max-content;width:-moz-max-content;width:max-content}.stages__nav{align-items:center;background-color:#fff;background-position:50%;background-repeat:no-repeat;background:#ededed;border:none;border-radius:50%;content:url("data:image/svg+xml;charset=utf-8,%3Csvg width=%276%27 height=%279%27 fill=%27none%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cpath d=%27m3.782 4.469-3.3 3.3.942.942L5.667 4.47 1.424.226l-.942.943 3.3 3.3Z%27 fill=%27%2309121F%27/%3E%3C/svg%3E");display:flex;justify-content:center;opacity:.5;padding:19px 20.5px;position:absolute;transition:.4s;transition:1s;z-index:5}.stages__nav:hover img{filter:invert(92%) sepia(0) saturate(0) hue-rotate(329deg) brightness(112%) contrast(103%)}.stages__nav:active{background:linear-gradient(90deg,#7690c9,#00aeba)}.stages__nav:active img{filter:invert(92%) sepia(0) saturate(0) hue-rotate(329deg) brightness(112%) contrast(103%)}.stages__nav:disabled{opacity:.6}.stages__nav_left,.stages__nav_reversed{transform:matrix(-1,0,0,1,0,0)}.stages__nav_left{left:3%;top:48%}.stages__nav_right{right:3%;top:48%}.stages__nav:hover{background:linear-gradient(90deg,rgba(118,144,201,.8),rgba(0,174,186,.8))}

