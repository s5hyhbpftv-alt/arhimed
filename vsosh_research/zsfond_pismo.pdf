          <div class="response-modal" id="response_modal">
        <div class="response-modal__window">
          <div class="response-modal__icon">
            <img src="https://zsfond.ru/wp-content/themes/zsfond/img/subscribe-img.png">
          </div>
          <div class="response-modal__title" id="response_modal_title"></div>
          <div class="response-modal__text" id="response_modal_text"></div>
          <div class="response-modal__close-button" id="response_modal_button" onclick="responseModalClose()"></div>
        </div>
      </div>

      <script>
        function responseModalOpen(title, buttonText, text=null) {
          if(!title || !buttonText) {
            console.warn("Неверное использование фунукции responseModalOpen");
            return;
          }
          const responseModal = document.getElementById("response_modal");
          if (!responseModal) {
            return;
          }
          const modalTitle = responseModal.querySelector("#response_modal_title");
          modalTitle.innerHTML = title;

          const modalButton = responseModal.querySelector("#response_modal_button");
          modalButton.innerHTML = buttonText;
          
          const modalText = responseModal.querySelector("#response_modal_text");
          if (text) {
            modalText.innerHTML = text;
            modalText.style.display = "block";
          }
          else {
            modalText.style.display = "none";
          }

          responseModal.classList.add('response-modal_active');
        }
        function responseModalClose() {
          const responseModal = document.getElementById("response_modal");
          responseModal.classList.remove('response-modal_active');
        }
      </script>

