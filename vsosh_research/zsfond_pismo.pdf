<script>
	function onSearchSubmit(loaderId) {
		const searchContentElement = document.getElementById("searchContent");
		if (searchContentElement) {
			searchContentElement.style.display = 'none';
		}
		if (!loaderId) {
			return;
		}
		const loaderElement = document.getElementById(loaderId);
		if (loaderElement) {
			loaderElement.style.display = 'flex';
		}

		const inputElement = document.getElementById("s-1");
		if (inputElement) {
			inputElement.blur();
		}

		const buttonElement = document.getElementById("searchButton");
		if (buttonElement) {
			buttonElement.focus();
		}


		if (loaderElement) {
			loaderElement.scrollIntoView({ block: "center", behavior: "smooth" });
		}

	}
</script>

