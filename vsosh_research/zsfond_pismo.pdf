<style id='zs-stage-detailed-style-inline-css'>
@import url(https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Roboto:wght@400;500&display=swap);
.stage-detailed-card{background:linear-gradient(90deg,#7690c9,#00aeba);border-radius:16px;padding:2px;width:286px}.stage-detailed-card__wrap{align-items:flex-start;background:#fff;border-radius:14px;display:flex;flex-direction:column;gap:12px;max-width:288px;padding:32px 24px}.stage-detailed-card__date{background:linear-gradient(90deg,#7690c9,#00aeba);border-radius:16px;font-family:Roboto;font-size:12px;font-style:normal;font-weight:500;line-height:14px;padding:2px}.stage-detailed-card__date .wrap{background:#fff;border-radius:14px;padding:6px 12px}.stage-detailed-card__date .content{-webkit-background-clip:text;background-clip:text;background-image:linear-gradient(90deg,#7690c9,#00aeba);color:transparent;text-transform:lowercase}.stage-detailed-card__caption{color:#1d1d1d;font-family:Montserrat;font-size:20px;font-style:normal;font-weight:700;letter-spacing:-.03em;line-height:24px;min-height:48px;text-transform:uppercase}.stage-detailed-card__image-wrapper{align-items:flex-start;display:flex;height:180px;justify-content:center;width:180px}.stage-detailed-card__image{height:100%;-o-object-fit:cover;object-fit:cover;width:100%}.stage-detailed-card__subcaption{font-weight:600}.stage-detailed-card__description,.stage-detailed-card__subcaption{color:#1d1d1d;font-family:Roboto;font-size:14px;font-style:normal;line-height:16px;opacity:.6}.stage-detailed-card__description{font-weight:400;min-height:60px}.stage-detailed-card__detailed-button{align-items:center;background:linear-gradient(90deg,#7690c9,#00aeba);border:none;border-radius:24px;color:#1d1d1d;color:#fff;display:flex;font-family:Roboto;font-size:14px;font-style:normal;font-weight:500;justify-content:center;line-height:16px;outline:none;padding:16px 28px;transition:.4s}.stage-detailed-card__detailed-button:hover{background:linear-gradient(90deg,rgba(118,144,201,.8),rgba(0,174,186,.8));color:#fff}.stage-detailed-card__detailed-button:disabled{background:linear-gradient(90deg,rgba(118,144,201,.4),rgba(0,174,186,.4));color:#fff}

</style>
