        function faqModalOpen() {
          const faqModal = document.getElementById('faq-modal');
          const root = document.querySelector("html");
          root.style.overflow = 'hidden';
          faqModal.classList.add('faq-modal_active');
        }
        function faqModalClose() {
          const faqModal = document.getElementById('faq-modal');
